#version 430

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 position;
    vec4 velocity;
    vec4 color;
    float life;
    float size;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

uniform float deltaTime;
uniform vec3 gravity;
uniform float damping;
uniform float minLife;
uniform float maxLife;
uniform vec3 emitterPosition;
uniform float emitterRadius;

// Random number generation
float rand(vec2 co) {
    return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= particles.length()) return;

    Particle particle = particles[index];

    // Update life
    particle.life -= deltaTime;

    // Reset dead particles
    if (particle.life <= 0.0) {
        float angle = rand(vec2(index, deltaTime)) * 2.0 * 3.14159;
        float radius = rand(vec2(deltaTime, index)) * emitterRadius;

        particle.position.xyz = emitterPosition + vec3(
            radius * cos(angle),
            0.0,
            radius * sin(angle)
        );

        particle.velocity.xyz = vec3(
            rand(vec2(index, time)) * 2.0 - 1.0,
            rand(vec2(time, index)) * 2.0,
            rand(vec2(index + 1.0, time)) * 2.0 - 1.0
        ) * 5.0;

        particle.life = mix(minLife, maxLife, rand(vec2(index, time)));
        particle.color = vec4(1.0);
        particle.size = 1.0;
    }

    // Update physics
    particle.velocity.xyz += gravity * deltaTime;
    particle.velocity.xyz *= damping;
    particle.position.xyz += particle.velocity.xyz * deltaTime;

    // Color fade based on life
    particle.color.a = particle.life / maxLife;

    // Write back
    particles[index] = particle;
}